# ============================================================
#  FlyRain KB 环境变量配置
#  复制本文件为 .env 后修改：cp .env.example .env
#  标注 [必改] 的项在生产环境必须修改，否则存在安全风险
# ============================================================

# ---------- Django ----------
# 运行环境：dev=开发（DEBUG开、CORS全放行），prod=生产（DEBUG关）
DJANGO_SETTINGS_MODULE=flyrain_kb.settings.dev

# [必改] Django 密钥，用于会话签名等。生产环境请使用随机字符串（≥50字符）
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-secret

# 调试模式，生产环境必须为 False（prod settings 会强制覆盖为 False）
DEBUG=True

# 允许的主机名，逗号分隔。生产环境填写你的域名，如 kb.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- PostgreSQL (pgvector) ----------
DB_NAME=flyrain_kb
DB_USER=flyrain
# [必改] 数据库密码，生产环境请修改为强密码。docker-compose 中 postgres 容器同步使用此值
DB_PASSWORD=flyrain123
# Docker 内部网络中主机名为服务名 postgres；本地开发用 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------- Redis (Celery Broker) ----------
# Docker 内部主机名为 redis；本地开发用 127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 大模型（OpenAI 兼容协议） ----------
# [必改] 模型 API 地址，兼容 OpenAI 协议。DeepSeek: https://api.deepseek.com/v1
DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
# [必改] 模型 API 密钥
DEFAULT_LLM_API_KEY=sk-xxx
# 对话模型名称，如 deepseek-chat / gpt-4o / qwen-plus
DEFAULT_LLM_MODEL=deepseek-chat
# 向量嵌入模型名称，如 text-embedding-3-small / text-embedding-v1
DEFAULT_EMBEDDING_MODEL=text-embedding
# 向量维度，必须与嵌入模型输出维度一致。如 text-embedding-3-small=1536，bge-m3=1024
DEFAULT_EMBEDDING_DIM=1024

# ---------- CORS（生产环境） ----------
# 允许跨域的前端域名，逗号分隔，如 https://kb.example.com
# 开发环境（dev settings）会自动放行所有来源，无需配置
CORS_ALLOWED_ORIGINS=

# ---------- 全文检索分词器 ----------
# simple: 默认，英文按空格切分、中文按单字切分（无需额外扩展）
# jieba:  中文精准分词，需在 PostgreSQL 中安装 pg_jieba 扩展（CREATE EXTENSION jieba;）
SEARCH_CONFIG=simple
